---
import '../styles/global.css';
import { NOM, nav, accents } from '../data';
import Logo from '../components/Logo.astro';
const { title, description = '', dir = 'b' } = Astro.props;
---
<!doctype html>
<html lang="fr" data-dir={dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={Astro.url.pathname} />
  <script is:inline>try{var t=localStorage.getItem("theme");if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/Gambarino-400.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <a class="skip" href="#contenu">Aller au contenu</a>
  <header class="top"><div class="wrap">
    <a class="logo" href="/" aria-label="Noema, accueil"><Logo /></a>
    <nav class="main" aria-label="Navigation principale">
      {nav.map(([l, h]) => <a href={h.startsWith('#') ? `/${h}` : `/${h}`}>{l}</a>)}
      <button type="button" class="switch" id="theme" role="switch" aria-checked="false" aria-label="Mode sombre">
        <svg class="sun" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></g></svg>
        <svg class="moon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z" fill="currentColor"/></svg>
        <span class="knob"></span>
      </button>
      <a class="btn small" href="/#pilote">Rejoindre le pilote</a>
    </nav>
  </div></header>
  <main id="contenu"><slot /></main>
  <footer><div class="wrap">
    <p>{NOM} est un outil de gestion administrative. Il ne remplace ni le jugement clinique ni les obligations légales du praticien. Les règles de la convention INAMI évoluent : le praticien reste responsable de leur application.</p>
    <p><span class="todo">[entité légale]</span> · <span class="todo">[adresse e-mail]</span> · <a href="/a-propos/">À propos</a> · Mentions légales · Confidentialité</p>
  </div></footer>
  <script is:inline>
    (function(){var b=document.getElementById('theme'),r=document.documentElement,m=matchMedia('(prefers-color-scheme: dark)');
    function dark(){return r.dataset.theme?r.dataset.theme==='dark':m.matches}
    function show(){b.setAttribute('aria-checked',dark())}
    show();m.addEventListener('change',show);
    b.addEventListener('click',function(){var t=dark()?'light':'dark';r.dataset.theme=t;try{localStorage.setItem('theme',t)}catch(e){}show()});})();
  </script>
  <script is:inline define:vars={{ accents }}>
    try{var c=localStorage.getItem('accent');if(c)document.documentElement.style.setProperty('--accent',c)}catch(e){}
    document.querySelectorAll('.swatches button').forEach(function(b){
      b.addEventListener('click',function(){
        var v=b.dataset.c;document.documentElement.style.setProperty('--accent',v);
        document.querySelectorAll('.swatches button').forEach(function(o){o.setAttribute('aria-pressed',o===b)});
        try{localStorage.setItem('accent',v)}catch(e){}
      });
    });
  </script>
</body>
</html>
