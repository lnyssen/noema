---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
const blocs = [
  ['Agenda et rendez-vous', 'Un agenda qui sait où vous êtes, et des patients qui n’ont plus besoin de vous écrire pour déplacer une séance.',
   ['Agenda de la semaine en glisser-déposer, plusieurs lieux de consultation', 'Alerte quand le temps de trajet entre deux lieux est trop court', 'Feuille de route imprimable', 'Prise de rendez-vous en ligne : créneaux calculés d’après les horaires, les congés et l’agenda, demande à confirmer, liste d’attente quand vous n’acceptez plus de nouveaux patients', 'Rappel par e-mail la veille, avec un lien pour annuler ou déplacer jusqu’à 24 heures avant', 'Synchronisation avec Google Agenda dans les deux sens'],
   'Moins de messages d’aller-retour, moins de trous dans la journée.', '/captures/agenda.webp', 'Agenda de la semaine avec séances réparties sur trois lieux.'],
  ['Dossiers', 'Une fiche par patient, et la possibilité de repartir de vos fichiers existants.',
   ['Coordonnées, parents pour les mineurs, notes de dossier', 'Notes de séance et documents chiffrés avant d’être enregistrés', 'Import depuis un fichier Excel, détection de doublons et fusion', 'Droits RGPD : export du dossier, anonymisation, suppression'],
   'Vous ne repartez pas de zéro, et vous pouvez répondre à une demande d’accès.', null, null],
  ['Facturation et comptabilité', 'Les papiers qui suivent la séance, et ceux qu’on repousse d’habitude au week-end.',
   ['Reçus d’honoraires en PDF, envoi par e-mail ou partage WhatsApp', 'Relances d’impayés avec code QR de paiement (virement SEPA)', 'Attestations de présence en PDF (mutuelle, assurance, employeur, école)', 'Convention INAMI de première ligne : plafonds de séances sur douze mois, suivi trimestriel, export', 'Facturation à un établissement (une école) avec factures numérotées', 'Dépenses avec lecture automatique du reçu photographié, chiffres de l’année, statistiques d’activité, export pour le comptable'],
   'La relance qu’on n’ose pas envoyer est déjà prête.', '/captures/ppl.webp', 'Suivi trimestriel de la convention de première ligne.'],
  ['Confort et sécurité', 'Un outil qui s’ouvre vite et se referme tout seul.',
   ['Connexion par mot de passe ou Face ID / empreinte', 'Verrouillage automatique après 30 minutes d’inactivité', 'Sauvegarde chiffrée quotidienne, avec alerte si elle ne tourne plus', 'Installable sur téléphone comme une application', 'Huit couleurs d’accent, thème clair, sombre ou automatique, taille de l’interface', 'Documentation intégrée avec captures d’écran'],
   'Vous le sortez entre deux séances sans y penser.', '/captures/reglages-securite.webp', 'Réglages de sécurité de l’accès.'],
];
---
<Base title="Fonctionnalités · Noema" description="Agenda, dossiers, facturation et confort : ce que fait l’outil, concrètement.">
  <section><div class="wrap"><p class="eyebrow">Fonctionnalités</p><h1>Ce que fait l’outil</h1><p>Tout ce qui suit existe et fonctionne aujourd’hui.</p></div></section>
  {blocs.map(([t, ctx, liste, change, img, alt], i) => (
    <section class={i % 2 === 0 ? 'tinted' : ''}><div class={`wrap split ${i % 2 ? 'rev' : ''}`}>
      <div>
        <h2>{t}</h2><p>{ctx}</p>
        <ul class="plain">{liste.map(l => <li>{l}</li>)}</ul>
        <p class="notice" style="margin-top:1.2rem">Ce que ça change : {change}</p>
      </div>
      {img && <Frame src={img} alt={alt} width={img.includes('securite') ? 1456 : 1300} height={img.includes('securite') ? 1698 : img.includes('ppl') ? 720 : 1000} />}
    </div></section>
  ))}
  <section><div class="wrap"><h2>Ce que l’outil ne fait pas</h2>
    <p>Pas de vidéoconsultation, pas d’intelligence artificielle qui lit ou résume vos séances, pas de dossier partagé entre praticiens, pas de rappels par SMS, pas de télétransmission automatique à l’INAMI ou à la mutuelle, pas encore de néerlandais.</p>
    <div class="cta"><a class="btn" href="/#pilote">Rejoindre le pilote</a></div></div></section>
</Base>
